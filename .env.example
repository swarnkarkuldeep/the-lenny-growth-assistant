=============================================================================
# DATABASE - IMPORTANT: Different URLs for Docker vs Host
=============================================================================

# Use this DATABASE_URL when running INSIDE Docker containers
# (services communicate via internal container network name 'postgres'):
# DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@postgres:5432/lenny_assistant

# Use this DATABASE_URL when running on the HOST MACHINE
# (pytest, scripts, etc. connect to Docker-mapped port on localhost):
DATABASE_URL=postgresql://postgres:${DB_PASSWORD}@localhost:5432/lenny_assistant

# Database password (same for both host and Docker connections):
DB_PASSWORD=password

=============================================================================
# OLLAMA (Local LLM embedding & generation)
=============================================================================

# From inside Docker containers:
# OLLAMA_BASE_URL=http://ollama:11434

# From host machine:
OLLAMA_BASE_URL=http://localhost:11434

=============================================================================
# GOOGLE GEMINI (Cloud LLM, optional)
=============================================================================

GEMINI_API_KEY=your-gemini-api-key-here

=============================================================================
# RETRIEVAL SETTINGS
=============================================================================

RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

=============================================================================
# LOGGING
=============================================================================

LOG_LEVEL=INFO
