# Base URL of the FastAPI backend. From the host machine during local `npm run dev`,
# the backend is reachable at localhost:8000. Inside the Docker Compose network,
# the frontend Dockerfile builds a static bundle served by nginx, which proxies
# /api to the fastapi service directly (see nginx.conf) - VITE_API_URL is only
# consulted for a non-proxied direct build.
VITE_API_URL=http://localhost:8000
